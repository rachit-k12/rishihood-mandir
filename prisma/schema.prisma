generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Donor {
  id                 String     @id @default(uuid()) @db.Uuid
  fullName           String     @map("full_name")
  email              String
  phone              String
  address            String
  pan                String?
  aadhaarMasked      String?    @map("aadhaar_masked")
  dateOfBirth        String?    @map("date_of_birth")
  gender             String?
  digilockerVerified Boolean    @default(false) @map("digilocker_verified")
  digilockerId       String?    @map("digilocker_id")
  panDocUrl          String?    @map("pan_doc_url")
  aadhaarDocUrl      String?    @map("aadhaar_doc_url")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  donations          Donation[]

  @@unique([email, phone])
  @@map("donors")
}

model Donation {
  id          String   @id @default(uuid()) @db.Uuid
  donorId     String   @map("donor_id") @db.Uuid
  donor       Donor    @relation(fields: [donorId], references: [id])
  txnid       String   @unique
  amount      Decimal  @db.Decimal(12, 2)
  status      String   @default("pending")
  paymentMode String?  @map("payment_mode")
  bankRefNum  String?  @map("bank_ref_num")
  anonymous   Boolean  @default(false)
  receiptUrl  String?  @map("receipt_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("donations")
}
